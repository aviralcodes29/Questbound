# Supabase Configuration for Questbound
# Replace these with your actual Supabase project URL and anon public key
# NOTE: Never expose a Supabase service-role key in frontend variables!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Set to "true" to force local offline preview mode (with simulated database persistence)
VITE_DEMO_MODE=false
